+#scroll-top-btn:hover { transform: translateY(-4px); background: var(--secondary); }
+
+/* Data freshness bar */
+.data-freshness-bar {
+    background: #0F2849; color: rgba(255,255,255,0.9);
+    text-align: center; font-size: 0.78rem; padding: 6px 12px;
+}
+.data-freshness-bar a { color: #93C5FD; }
+
+/* What-if slider */
+.whatif-controls { display: flex; align-items: center; gap: 14px; }
+.whatif-controls input[type=range] { flex: 1; accent-color: var(--primary); }
+.whatif-cgpa-label { font-weight: 800; font-size: 1.1rem; color: var(--primary); min-width: 48px; }
+.whatif-preview {
+    margin-top: 12px; padding: 12px 14px; background: #F0F9FF;
+    border: 1px solid #BAE6FD; border-radius: 8px; font-size: 0.85rem;
+}
+.whatif-preview.whatif-loading { opacity: 0.6; }
+.whatif-list { list-style: none; padding: 0; margin: 8px 0 0; }
+.whatif-list li { padding: 4px 0; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.whatif-num { background: var(--primary); color: #fff; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; }
+.whatif-prob.high { color: #065F46; font-weight: 700; }
+.whatif-prob.med { color: #92400E; font-weight: 700; }
+.whatif-prob.low { color: #991B1B; font-weight: 700; }
+
+/* Share buttons */
+.btn-whatsapp-sm { background: #25D366 !important; }
+.btn-telegram-sm { background: #0088cc !important; }
+
+/* Timeline */
+.timeline-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
+.timeline-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 16px; border-left: 4px solid var(--secondary); }
+.timeline-date { font-size: 0.82rem; color: var(--secondary); font-weight: 700; margin-bottom: 8px; }
+
+.rank-mode-note { font-size: 0.85rem; color: var(--muted); margin-bottom: 16px; padding: 10px; background: #F8FAFC; border-radius: 6px; }
+
+/* =============================================
+   PREMIUM GLASSMORPHISM & VISUAL ENGAGEMENT POLISH
+   ============================================= */
+.glass-panel {
+    background: rgba(255, 255, 255, 0.7);
+    backdrop-filter: blur(12px);
+    -webkit-backdrop-filter: blur(12px);
+    border: 1px solid rgba(255, 255, 255, 0.3);
+    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.04);
+}
+
+.hero {
+    background: radial-gradient(circle at 80% 20%, #1e3a8a 0%, #0f172a 100%);
+    position: relative;
+    overflow: hidden;
+}
+
+.hero::before {
+    content: '';
+    position: absolute;
+    top: 0; left: 0; right: 0; bottom: 0;
+    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(236, 72, 153, 0.05) 100%);
+    pointer-events: none;
+}
+
+.hero-actions .hero-btn.primary {
+    background: linear-gradient(135deg, #FF9933 0%, #FF8000 100%);
+    color: #fff;
+    box-shadow: 0 4px 15px rgba(255, 153, 51, 0.4);
+    border: none;
+    font-weight: 700;
+}
+
+.hero-actions .hero-btn.primary:hover {
+    background: linear-gradient(135deg, #ffaa4f 0%, #ff911b 100%);
+    transform: translateY(-2px);
+    box-shadow: 0 6px 20px rgba(255, 153, 51, 0.6);
+}
+
+/* Make tables scroll nicely on mobile and feel native */
+@media (max-width: 768px) {
+    .info-details-grid {
+        grid-template-columns: 1fr !important;
+    }
+    
+    #map-container {
+        height: 220px !important;
+    }
+    
+    .placement-metrics-grid {
+        grid-template-columns: 1fr !important;
+    }
+    
+    .table-wrapper {
+        border: 1px solid var(--border);
+        border-radius: 8px;
+    }
+}
