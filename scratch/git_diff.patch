+<script>
+document.addEventListener('DOMContentLoaded', function() {
+    // 1. Initialize Map Variables
+    const collegeCoords = {{ coords | tojson | safe }};
+    const cityCoords = {{ city_coords | tojson | safe }} || {};
+    const collegeName = {{ college_name | tojson | safe }};
+    const homeCity = {{ home_city | tojson | safe }};
+    
+    const mapDiv = document.getElementById('map-container');
+    if (!mapDiv) return;
+    
+    // Fallback coordinates (Bhopal center) if college coords are missing
+    const finalCollegeCoords = collegeCoords && collegeCoords.length === 2 ? collegeCoords : [23.2599, 77.4126];
+    
+    // Initialize map with disabled scroll wheel zoom initially to prevent search scroll issues
+    const map = L.map('map-container', {
+        scrollWheelZoom: false
+    }).setView(finalCollegeCoords, 12);
+    
+    // Enable scroll wheel zoom only when user clicks/focuses on map
+    map.on('focus', () => { map.scrollWheelZoom.enable(); });
+    map.on('blur', () => { map.scrollWheelZoom.disable(); });
+    
+    // Add OpenStreetMap Tile Layer
+    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
+        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
+        maxZoom: 19
+    }).addTo(map);
+    
+    // Custom SVG Marker Icons
+    const collegeIcon = L.divIcon({
+        html: `
+            <div class="custom-map-marker college-marker-pin">
+                <div class="marker-pulse"></div>
+                <div class="marker-icon-wrapper">
+                    <i class="fas fa-graduation-cap"></i>
+                </div>
+            </div>
+        `,
+        className: 'custom-marker-container',
+        iconSize: [40, 40],
+        iconAnchor: [20, 40],
+        popupAnchor: [0, -40]
+    });
+    
+    const homeIcon = L.divIcon({
+        html: `
+            <div class="custom-map-marker home-marker-pin">
+                <div class="marker-pulse"></div>
+                <div class="marker-icon-wrapper">
+                    <i class="fas fa-home"></i>
+                </div>
+            </div>
+        `,
+        className: 'custom-marker-container',
+        iconSize: [40, 40],
+        iconAnchor: [20, 40],
+        popupAnchor: [0, -40]
+    });
+    
+    // Add College Marker
+    const collegeMarker = L.marker(finalCollegeCoords, { icon: collegeIcon })
+        .addTo(map)
+        .bindPopup(`<strong>≡ƒÄô ${collegeName}</strong><br><span style="color:var(--muted);font-size:0.8rem;">Destination Campus</span>`);
+        
+    if (!homeCity || homeCity === 'All' || !cityCoords[homeCity]) {
+        // No home city, center on college
+        collegeMarker.openPopup();
+        map.setView(finalCollegeCoords, 13);
+    } else {
+        const homeLat = parseFloat(cityCoords[homeCity].lat);
+        const homeLng = parseFloat(cityCoords[homeCity].lng);
+        const homeCoords = [homeLat, homeLng];
+        
+        // Add Home Marker
+        const homeMarker = L.marker(homeCoords, { icon: homeIcon })
+            .addTo(map)
+            .bindPopup(`<strong>≡ƒÅá ${homeCity}</strong><br><span style="color:var(--muted);font-size:0.8rem;">Your starting point</span>`);
+            
+        // Calculate curved route points using Quadratic Bezier Formula
+        function getBezierPoints(p1, p2, pointsCount = 40) {
+            const lat1 = p1[0], lng1 = p1[1];
+            const lat2 = p2[0], lng2 = p2[1];
+            
+            const midLat = (lat1 + lat2) / 2;
+            const midLng = (lng1 + lng2) / 2;
+            
+            const dLat = lat2 - lat1;
+            const dLng = lng2 - lng1;
+            
+            // Perpendicular offset based on distance
+            const offsetLat = -dLng * 0.15;
+            const offsetLng = dLat * 0.15;
+            
+            const cLat = midLat + offsetLat;
+            const cLng = midLng + offsetLng;
+            
+            const points = [];
+            for (let i = 0; i <= pointsCount; i++) {
+                const t = i / pointsCount;
+                const bLat = Math.pow(1 - t, 2) * lat1 + 2 * (1 - t) * t * cLat + Math.pow(t, 2) * lat2;
+                const bLng = Math.pow(1 - t, 2) * lng1 + 2 * (1 - t) * t * cLng + Math.pow(t, 2) * lng2;
+                points.push([bLat, bLng]);
+            }
+            return points;
+        }
+        
+        const routePoints = getBezierPoints(homeCoords, finalCollegeCoords);
+        
+        // Draw elegant glowing path line
+        L.polyline(routePoints, {
+            color: '#1D4ED8',
+            weight: 4,
+            opacity: 0.8,
+            className: 'animated-route-line'
+        }).addTo(map);
+        
+        // Set view to include both markers with decent padding
+        const bounds = L.latLngBounds([homeCoords, finalCollegeCoords]);
+        map.fitBounds(bounds, { padding: [50, 50] });
+        
+        // Open college popup
+        collegeMarker.openPopup();
+    }
+});
+
+// Auto-submit home city dropdown on change
+document.querySelector('select[name="home_city"]')?.addEventListener('change', function() {
+    this.closest('form').submit();
+});
+</script>
+
+{% if chart_data and chart_data.labels %}
+<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
+<script>
+document.addEventListener('DOMContentLoaded', function() {
+    const ctx = document.getElementById('cutoff-chart');
+    if (!ctx) return;
+    new Chart(ctx, {
+        type: 'bar',
+        data: {
+            labels: {{ chart_data.labels | tojson | safe }},
+            datasets: [
+                { label: '2024 Avg Closing', data: {{ chart_data.data_2024 | tojson | safe }}, backgroundColor: '#94A3B8' },
+                { label: '2025 Avg Closing', data: {{ chart_data.data_2025 | tojson | safe }}, backgroundColor: '#1D4ED8' }
+            ]
+        },
+        options: {
+            responsive: true,
+            plugins: { legend: { position: 'top' } },
+            scales: { y: { title: { display: true, text: 'Closing Rank' }, reverse: false } }
+        }
+    });
+});
+</script>
+{% endif %}
+<script>
+document.getElementById('review-form')?.addEventListener('submit', function(e) {
+    e.preventDefault();
+    const fd = new FormData(this);
+    const body = Object.fromEntries(fd.entries());
+    fetch('/api/v1/reviews', {
+        method: 'POST',
+        headers: {'Content-Type': 'application/json'},
+        body: JSON.stringify(body)
+    }).then(r => r.json()).then(d => {
+        if (d.success) { alert('Thank you! Review submitted.'); location.reload(); }
+        else alert(d.error || 'Failed to submit');
+    });
+});
+</script>
+{% endblock %}
