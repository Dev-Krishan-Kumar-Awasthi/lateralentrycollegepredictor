+const allCards = document.querySelectorAll('.faq-card');
+const allSections = document.querySelectorAll('.faq-cat-section');
+const noResults = document.getElementById('faqNoResults');
+const searchInput = document.getElementById('faqSearchInput');
+const clearBtn = document.getElementById('faqClearBtn');
+let currentCat = 'all';
+
+function filterCat(btn, cat) {
+  document.querySelectorAll('.faq-tab').forEach(t => t.classList.remove('active'));
+  btn.classList.add('active');
+  currentCat = cat;
+  applyFilters();
+}
+
+function clearFaqSearch() {
+  searchInput.value = '';
+  clearBtn.style.display = 'none';
+  applyFilters();
+}
+
+searchInput.addEventListener('input', () => {
+  clearBtn.style.display = searchInput.value ? 'block' : 'none';
+  applyFilters();
 });
+
+function applyFilters() {
+  const q = searchInput.value.toLowerCase().trim();
+  let anyVisible = false;
+
+  allCards.forEach(card => {
+    const question = card.dataset.question || '';
+    const keywords = card.dataset.keywords || '';
+    const cat = card.dataset.cat || '';
+    const matchesCat = (currentCat === 'all' || cat === currentCat);
+    const matchesQ = !q || question.includes(q) || keywords.includes(q);
+    const show = matchesCat && matchesQ;
+    card.classList.toggle('hidden', !show);
+    if (show) anyVisible = true;
+  });
+
+  // Hide/show sections based on whether they have visible cards
+  allSections.forEach(sec => {
+    const hasCat = (currentCat === 'all' || sec.dataset.category === currentCat);
+    const visibleInSection = Array.from(sec.querySelectorAll('.faq-card'))
+      .some(c => !c.classList.contains('hidden'));
+    sec.style.display = hasCat && visibleInSection ? '' : 'none';
+  });
+
+  noResults.style.display = anyVisible ? 'none' : 'block';
+}
 </script>
